# Frontend reads backend/.env automatically (vite.config.ts).
# Edit backend/.env instead of duplicating values here.
#
# Mapped for the browser:
#   PORT              → VITE_API_URL (http://localhost:PORT)
#   SUPABASE_URL      → VITE_SUPABASE_URL
#   SUPABASE_ANON_KEY → VITE_SUPABASE_PUBLISHABLE_KEY
#
# Never put JWT_SECRET or SUPABASE_SERVICE_ROLE_KEY in the frontend.

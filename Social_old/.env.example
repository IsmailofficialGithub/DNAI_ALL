# .env.example - Template for environment variables
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in your actual values

# Environment identifier
VITE_ENVIRONMENT=development

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OAuth - Facebook/Instagram
VITE_FACEBOOK_APP_ID=your_facebook_app_id
VITE_FACEBOOK_APP_SECRET=your_facebook_app_secret
VITE_INSTAGRAM_CLIENT_ID=your_instagram_client_id
VITE_INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret

# OAuth - LinkedIn
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id
VITE_LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# OAuth - TikTok
VITE_TIKTOK_CLIENT_KEY=your_tiktok_client_key
VITE_TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# API Endpoints
VITE_N8N_BASE_URL=https://auto.nsolbpo.com
VITE_API_BASE_URL=https://dev.duhanashrah.ai/api/api
VITE_AUTH_API_URL=https://dev.duhanashrah.ai/api/api/auth
VITE_SUPPORT_API_URL=https://dev.duhanashrah.ai/api/api/public/customer-support
VITE_SUPPORT_API_KEY=your_support_api_key
VITE_SUPPORT_WIDGET_URL=https://dev.duhanashrah.ai/support-widget.js

# Application URLs
VITE_APP_URL=http://localhost:5173
VITE_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/auth/new-password

# OAuth Redirect URIs
VITE_FACEBOOK_REDIRECT_URI=http://localhost:5173/integrations/callback/facebook
VITE_INSTAGRAM_REDIRECT_URI=http://localhost:5173/integrations/callback/instagram
VITE_LINKEDIN_REDIRECT_URI=http://localhost:5173/oauth/linkedin/callback
VITE_TIKTOK_REDIRECT_URI=http://localhost:5173/integrations/callback/tiktok